# App
APP_NAME=go-eprescription-clean
APP_VERSION=1.0.0
# HTTP settings
HTTP_PORT=8080
HTTP_USE_PREFORK_MODE=false
# Logger
LOG_LEVEL=debug
# PG
DB_NAME=go-prescription-clean
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432
PG_POOL_MAX=2
PG_URL=postgresql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}
# gRPC
GRPC_PORT="8081"
# Metrics
METRICS_ENABLED=true
# Swagger
SWAGGER_ENABLED=true