# App
APP_NAME=go-eprescription-clean
APP_VERSION=1.0.0
# HTTP settings
HTTP_PORT=8080
HTTP_USE_PREFORK_MODE=false
# Logger
LOG_LEVEL=debug
# PG
PG_DB_NAME=go-prescription-clean
PG_USER=postgres
PG_PASSWORD=postgres
PG_HOST=localhost
PG_PORT=5432
PG_POOL_MAX=2
PG_URL=postgresql://${PG_USER}:${PG_PASSWORD}@${PG_HOST}:${PG_PORT}/${PG_DB_NAME}
# MG
MG_ENABLED=false
MG_DB_NAME=go-eprescription-clean
MG_HOST=localhost
MG_PORT=27017
MG_POOL_MAX=2
MG_URL=mongodb://${MG_HOST}:${MG_PORT}/${MG_DB_NAME}
# Metrics
METRICS_ENABLED=true
# Swagger
SWAGGER_ENABLED=true
# Midtrans
MIDTRANS_ENVIRONMENT=sandbox
MIDTRANS_CLIENT_KEY=SB-Mid-client-sadasdsdasd
MIDTRANS_SERVER_KEY=SB-Mid-server-asdasdadasdsad
#Xendit
XENDIT_SECRET_KEY=xnd_development_sdsasaawsdadsadasd
# RMQ
RMQ_SERVER=server
RMQ_CLIENT=client
RMQ_URL=amqp://guest:guest@localhost:5672/
# GRPC
GRPC_PORT=50051
